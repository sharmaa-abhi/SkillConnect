# ==============================================================================
# SkillConnect Environment Variables Configuration
# ==============================================================================

# TinyFish Free-Tier Live Local Price Intelligence
# Obtain your free API key at https://tinyfish.ai
# Free Tier Endpoints Used:
#   - Search: GET https://api.search.tinyfish.ai?query=...
#   - Fetch:  POST https://api.fetch.tinyfish.ai
# Note: Never expose this key in client-side bundles or NEXT_PUBLIC_* variables.
TINYFISH_API_KEY=

# Optional Flag to enable simulated responses when developing offline without an API key
NEXT_PUBLIC_ENABLE_MOCK_INTELLIGENCE=false
