# ==============================================================================
# SkillConnect — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or expose secrets in client-side code.
# All NEXT_PUBLIC_* variables are visible to the browser.
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 🔑 TinyFish API (Free Tier — Live Local Price Intelligence)
# ──────────────────────────────────────────────────────────────────────────────
# Get your free API key at: https://tinyfish.ai
# Used for real-time market price comparison in the Cost Estimator.
#
# Free Tier Endpoints:
#   • Search:  GET  https://api.search.tinyfish.ai?query=...
#   • Fetch:   POST https://api.fetch.tinyfish.ai
#
# ⚠️  NEVER prefix with NEXT_PUBLIC_ — this key must stay server-side only.
TINYFISH_API_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# 🧪 Development & Mock Settings
# ──────────────────────────────────────────────────────────────────────────────
# Set to "true" to use simulated price intelligence responses without API calls.
# Useful for offline development or when API quota is exhausted.
NEXT_PUBLIC_ENABLE_MOCK_INTELLIGENCE=false

# ──────────────────────────────────────────────────────────────────────────────
# 🌐 Application URLs
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SkillConnect

# ──────────────────────────────────────────────────────────────────────────────
# 📊 Future Integrations (Phase 2+)
# ──────────────────────────────────────────────────────────────────────────────
# Uncomment and configure when ready:
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# DATABASE_URL=postgresql://user:pass@localhost:5432/skillconnect
# REDIS_URL=redis://localhost:6379
#
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_PHONE_NUMBER=+1...
#
# RESEND_API_KEY=re_...
#
# PERSONA_API_KEY=persona_...
